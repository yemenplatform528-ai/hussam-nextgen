# Hussam NextGen v1.30 baseline configuration
# Never commit real credentials. Copy to .env locally.

# Required for any API process using the database layer.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/hussam

# Required by the current HS256 development authentication boundary.
# Production deployments should replace this with the approved external IdP plan.
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional
SQL_ECHO=false

# Optional provider-neutral AI adapter
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# First product release profile (marketplace-first)

# OIDC production/staging boundary (required by strict production config)
OIDC_CLIENT_ID=
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://api.example.com/api/v1/auth/oidc/callback
OIDC_STATE_SECRET=replace-with-at-least-32-random-characters

# Distributed rate limiting: use Redis or edge enforcement in production/staging.
RATE_LIMIT_EDGE_ENFORCED=true
# RATE_LIMIT_BACKEND=redis
# RATE_LIMIT_REDIS_URL=redis://USER:PASSWORD@HOST:6379/0
